# Client-side routing: serve index.html for any path that is not a real
# file or directory. Without this, /behandlungen/achseln returns 404 on
# refresh. If the site ever moves to a subdirectory, RewriteBase and
# vite.config.ts `base` must change together.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]

  # Pre-rendered pages live at dist/<path>/index.html. Serve them internally at
  # their canonical extensionless URL. Without this, mod_dir would 301-redirect
  # /laser to /laser/, adding a hop to every page and leaving the URL disagreeing
  # with the canonical the page itself declares.
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.+?)/?$ /$1/index.html [L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# mod_dir would 301 /laser to /laser/ before mod_rewrite gets a chance. The rule
# above serves the file directly instead, so the redirect is unwanted.
<IfModule mod_dir.c>
  DirectorySlash Off
</IfModule>

# DirectorySlash Off can expose a directory listing if a directory ever lacks an
# index file. Every pre-rendered directory has one, but this makes it safe
# regardless.
Options -Indexes

# Hashed asset filenames make a long cache safe.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
